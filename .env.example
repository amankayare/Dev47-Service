# Backend Environment Configuration
ENVIRONMENT=development
SERVE_FRONTEND=false
DATABASE_BACKEND=sqlalchemy
DATABASE_URL=postgresql+psycopg2://portfolio_user:change-me@localhost:5432/portfolio
JWT_SECRET=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-different-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Select DATABASE_BACKEND=cloudflare_d1 and provide all values below to use D1's HTTP API.
# Create a scoped Cloudflare API token with permission to query this D1 database.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_TIMEOUT=10

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Polyglot Storage Configuration
POLYGLOT_URL=https://polyglot.amankayare.com
POLYGLOT_API_KEY=your_polyglot_api_key_here

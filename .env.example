# Backend Environment Configuration
ENVIRONMENT=local
SERVE_FRONTEND=false
DATABASE_BACKEND=sqlalchemy
DATABASE_URL=sqlite:///instance/portfolio.db
JWT_SECRET=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-different-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Set DATABASE_BACKEND=cloudflare_d1 to route all Flask ORM queries to D1 over HTTP.
# Use the D1 database ID (not its display name).
# Use a scoped API token with D1 Read and D1 Write permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_TIMEOUT=10

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Polyglot Storage Configuration
POLYGLOT_URL=https://polyglot.amankayare.com
POLYGLOT_API_KEY=your_polyglot_api_key_here
